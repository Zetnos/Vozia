WHISPER_MODEL=base
# Supabase: mantenha todas as chaves privadas apenas no servidor.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Compatibilidade com a chave antiga, se este projeto ainda não tiver secret key:
# SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...
# URL pública do servidor (ativa cookies Secure e callbacks corretos em produção)
# PUBLIC_URL=https://vozia.seudominio.com
# Defina uma senha aleatória forte para o painel administrativo:
ADMIN_PASSWORD=troque-por-uma-senha-aleatoria-com-14-ou-mais-caracteres
# Opcional: caminho do Python, se não usar .venv\Scripts\python.exe
# PYTHON_EXECUTABLE=C:\Python312\python.exe
# Para hospedar: HOST=0.0.0.0 (use HTTPS e armazenamento persistente no servidor)
